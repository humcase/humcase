# Humcase — names of the environment variables it reads.
#
# Humcase does NOT load a `.env` file: set these variables in the Windows environment, or enter
# the keys in Settings → Voice and AI, where they are stored encrypted with DPAPI. This file only
# lists the names; never put a real key here (it is versioned).

# Dictation cleanup (LLM): one key per provider in use.
CEREBRAS_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CUSTOM_LLM_API_KEY=

# Transcription (voice).
DEEPGRAM_API_KEY=

# Optional overrides (model, URL).
CEREBRAS_MODEL=
OPENAI_MODEL=
GROQ_MODEL=
OPENROUTER_MODEL=
OLLAMA_MODEL=
CUSTOM_LLM_MODEL=
CUSTOM_LLM_BASE_URL=
